# Base de datos (elige UNA forma)

# Opción A — URL completa (contraseña entre : y @; si tiene caracteres especiales, codifícalos con encodeURIComponent)
DATABASE_URL=postgresql://postgres:123456789@localhost:5432/euphoria_lashes

# Opción B — variables sueltas (útil si la contraseña te da problemas al pegarla en la URL)
# PGUSER=postgres
# PGPASSWORD=123456789
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=euphoria_lashes

PORT=5174
VITE_API_URL=http://localhost:5174

# Firma de sesión (JWT simulado en el servidor)
AUTH_SECRET=cambia-esta-clave-secreta

# Cloudinary (elige UNA forma)
# Opción A (recomendada): URL completa del entorno
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
#
# Opción B: credenciales separadas
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret
#
# Carpeta destino para uploads de productos
CLOUDINARY_UPLOAD_FOLDER=euphoria-lashes/products

# Administrador en PostgreSQL (ejecuta una vez: npm run seed:admin)
ADMIN_EMAIL=tu-correo@ejemplo.com
ADMIN_PASSWORD=define-una-contraseña-segura
